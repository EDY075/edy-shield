# EDY Shield -> EDY SIEM is opt-in and disabled by default.
EDY_SIEM_ENABLED=false

# Canonical receiver base URL. Plain HTTP is accepted only on loopback.
EDY_SIEM_URL=http://127.0.0.1:8001

# Optional operator UI base URL. Falls back to EDY_SIEM_URL when omitted.
# Used only to build /investigate/shield/{event_id}; no token reaches the browser.
EDY_SIEM_UI_URL=http://127.0.0.1:5173

# Supply a unique machine-to-machine token through the process environment.
# Never commit a real token. The receiver requires at least 32 bytes.
EDY_SIEM_TOKEN=replace-with-a-random-lab-token-at-least-32-bytes
