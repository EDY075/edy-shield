# ─────────────────────────────────────────────
# EDY Shield — .gitignore (Python)
# ─────────────────────────────────────────────

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.pyd
*.dll

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# PyCharm / IDE
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# Environments and local secrets
.env
.env.*
!.env.example
.envrc
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
pythonenv/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Local runtime data, caches and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.cache

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Local databases and database sidecars
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# Local exports, dumps and backups
*.dump
*.bak
*.backup

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local files
local_settings.py
db.sqlite3
db.sqlite3-journal

# Build artifacts
*.whl
*.tar.gz
*.zip
!*.zip  # manter zips se necessário (ex.: assets de release)
